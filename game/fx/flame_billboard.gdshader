// Stylized 3D fire billboard shader.
// Adapted from GDQuest's godot-shaders "stylized_fire.gdshader" (MIT license,
// https://github.com/GDQuest/godot-shaders), itself based on Minionsart's
// stylized fire. Textures are generated procedurally in flame code (no
// GDQuest art assets are used).
shader_type spatial;
render_mode blend_add, depth_draw_never;

uniform sampler2D noise_texture;
uniform sampler2D texture_mask;
uniform float emission_intensity = 2.0;
uniform float time_scale = 3.0;
uniform vec2 texture_scale = vec2(0.012);
uniform float edge_softness = 0.35;

varying vec3 world_coord;
varying float world_x_dot;

void vertex() {
	// Billboard keep-scale, as generated by a converted StandardMaterial3D.
	mat4 mat_world = mat4(
			normalize(INV_VIEW_MATRIX[0]) * length(MODEL_MATRIX[0]),
			normalize(INV_VIEW_MATRIX[1]) * length(MODEL_MATRIX[0]),
			normalize(INV_VIEW_MATRIX[2]) * length(MODEL_MATRIX[2]),
			MODEL_MATRIX[3]);
	// Per-particle roll from INSTANCE_CUSTOM.x (angle), set by the process material.
	mat_world *= mat4(
			vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0),
			vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0),
			vec4(0.0, 0.0, 1.0, 0.0),
			vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat_world;
	// Sample noise on the xy and zy world planes, blended by facing.
	world_coord = (mat_world * vec4(VERTEX, 1.0)).xyz;
	vec4 world_normal = (mat_world * vec4(NORMAL, 0.0));
	world_x_dot = abs(dot(normalize(world_normal.xyz), vec3(1.0, 0.0, 0.0)));
}

void fragment() {
	// Round mask hides the quad's square silhouette.
	float mask = texture(texture_mask, UV).r;
	vec2 time_based_pan = vec2(0.2, 1.0) * (-TIME * time_scale);
	float noise_xy = texture(noise_texture, world_coord.xy * texture_scale + time_based_pan).r;
	float noise_zy = texture(noise_texture,
			world_coord.zy * texture_scale + time_based_pan + vec2(0.7, 0.3)).r;
	float noise = mix(noise_xy, noise_zy, clamp(world_x_dot, 0.0, 1.0));
	// Boost noise contrast so it reads as flame cells rather than gray mush.
	noise = smoothstep(0.32, 0.72, noise);
	ALBEDO = COLOR.rgb;
	EMISSION = ALBEDO * emission_intensity;
	// Threshold erosion: as the ramp's alpha falls over the particle's life,
	// the dissolve threshold rises and the flame cells shrink away.
	float erosion = 1.0 - COLOR.a;
	float cells = smoothstep(erosion, erosion + edge_softness, noise);
	ALPHA = clamp(mask * cells, 0.0, 1.0);
}
